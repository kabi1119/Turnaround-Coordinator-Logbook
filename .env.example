# Public browser configuration only. Copy to .env.local (ignored by Git).
# Missing values keep Guest Mode working and disable Account sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Use the Supabase publishable key, or legacy anon JWT. NEVER service_role/secret/SMTP keys.

# v0.9.0 preview integration ONLY. Leave false in ordinary production builds.
VITE_ACCOUNT_CLOUD_V2=false
