# Public browser configuration only. Copy to .env.local (ignored by Git).
# Missing values keep Guest Mode working and disable Account sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Use the Supabase publishable key, or legacy anon JWT. NEVER service_role/secret/SMTP keys.

# Development is off unless VITE_ACCOUNT_CLOUD_V2=preview is explicitly added.
# Production builds enable Cloud Account through scripts/production-account.mjs.
# Do not set false here: explicit disabling values block Production builds.
